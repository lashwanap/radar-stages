# Copie ce fichier en .env et remplis les clés.

# Clé API Claude (https://console.anthropic.com) — analyse du CV et notation des offres.
# Sans clé, l'app utilise une notation par mots-clés.
ANTHROPIC_API_KEY=

# Clés Adzuna (gratuites : https://developer.adzuna.com) — recherche automatique d'offres.
# Sans clés, tu peux quand même coller les annonces à la main.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

PORT=3001
