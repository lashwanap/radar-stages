# Copie ce fichier en .env et remplis les clés.

# Clé API Claude (https://console.anthropic.com) — analyse du CV et notation des offres.
# Sans clé, l'app utilise une notation par mots-clés.
ANTHROPIC_API_KEY=

# Clé JSearch (RapidAPI : https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch) — recherche automatique d'offres.
# Abonne-toi au plan gratuit « Basic », puis copie ta « X-RapidAPI-Key ».
# Sans clé, tu peux quand même coller les annonces à la main.
JSEARCH_API_KEY=

PORT=3001
